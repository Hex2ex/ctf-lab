#!/bin/bash
# CTF-Lab WireGuard helper. Installed root-owned to /usr/local/bin and allowed through sudoers, so that
# `ctf vpn` can manage peers without a password. Every input is validated strictly.
#   ctf-vpn-helper pubkey          print the server public key (creates the key on first use)
#   ctf-vpn-helper sync < peers    rewrite wg-ctf.conf from "name<TAB>ip<TAB>pubkey" lines and apply it
#   ctf-vpn-helper status          wg show wg-ctf
set -euo pipefail
umask 077
IF=wg-ctf; DIR=/etc/wireguard; CONF=$DIR/$IF.conf; KEYF=$DIR/$IF.key; PORT=51820
mkdir -p "$DIR"
[ -s "$KEYF" ] || wg genkey > "$KEYF"
case "${1:-}" in
  pubkey) wg pubkey < "$KEYF" ;;
  status) wg show "$IF" 2>/dev/null | grep -vE 'private key' || echo "wg-ctf is down" ;;
  sync)
    peers=""; ips=""; n=0
    while IFS=$'\t' read -r name ip pub rest; do
      [ -n "${name:-}" ] || continue
      [[ "$name" =~ ^[a-z0-9][a-z0-9-]{0,20}$ ]] || { echo "bad name: $name" >&2; exit 1; }
      [[ "$ip" =~ ^192\.168\.100\.([0-9]{3})$ ]] && [ "${BASH_REMATCH[1]}" -ge 210 ] && [ "${BASH_REMATCH[1]}" -le 250 ] || { echo "bad ip: $ip" >&2; exit 1; }
      [[ "$pub" =~ ^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$ ]] || { echo "bad key for $name" >&2; exit 1; }
      case " $ips " in *" $ip "*) echo "duplicate ip: $ip" >&2; exit 1;; esac
      ips="$ips $ip"; n=$((n+1)); [ $n -le 41 ] || { echo "too many peers" >&2; exit 1; }
      peers+=$'\n'"[Peer]"$'\n'"# $name"$'\n'"PublicKey = $pub"$'\n'"AllowedIPs = $ip/32"$'\n'
    done
    { echo "# Generated by ctf-vpn-helper — managed with 'ctf vpn'."
      echo "[Interface]"; echo "ListenPort = $PORT"; echo "PrivateKey = $(cat "$KEYF")"
      echo "PostUp = sysctl -qw net.ipv4.ip_forward=1; sysctl -qw net.ipv4.conf.virbr-ctf.proxy_arp=1 || true; /usr/local/bin/ctf-firewall.sh"
      printf '%s' "$peers"; } > "$CONF.new"
    mv "$CONF.new" "$CONF"
    if ip link show "$IF" >/dev/null 2>&1; then
      wg syncconf "$IF" <(wg-quick strip "$IF")
      # wg syncconf does not touch routes: keep one /32 route per peer
      for r in $(ip -4 route show dev "$IF" | awk '{print $1}'); do case " $ips " in *" ${r%/32} "*) ;; *) ip route del "$r" dev "$IF";; esac; done
      for a in $ips; do ip route replace "$a/32" dev "$IF"; done
    else
      systemctl enable --now "wg-quick@$IF.service" >/dev/null
    fi
    sysctl -qw net.ipv4.conf.virbr-ctf.proxy_arp=1 2>/dev/null || true
    echo "wg-ctf: $n peer(s)" ;;
  *) echo "usage: ctf-vpn-helper pubkey|sync|status" >&2; exit 2 ;;
esac
