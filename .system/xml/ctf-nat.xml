<network>
  <name>ctf-nat</name>
  <!-- Internet access for the Kali and targets VMs only (apt, docker pull). The firewall blocks the LAN. -->
  <forward mode='nat'/>
  <bridge name='virbr-ctfnat' stp='on' delay='0'/>
  <ip address='192.168.150.1' netmask='255.255.255.0'>
    <dhcp>
      <range start='192.168.150.100' end='192.168.150.200'/>
    </dhcp>
  </ip>
</network>
